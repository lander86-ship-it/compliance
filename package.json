{
  "name": "controlforge",
  "version": "0.1.0",
  "private": true,
  "description": "ControlForge — e-commerce platform for security hardening guides and standards (CIS/NIST/DISA-STIG) with per-customer customization and a document-generation engine.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.18.0 <21"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "docx": "8.5.0",
    "exceljs": "4.4.0",
    "fast-xml-parser": "^4.5.7",
    "next": "^14.2.35",
    "papaparse": "5.4.1",
    "pdf-lib": "1.17.1",
    "prisma": "5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^17.7.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.0",
    "@types/papaparse": "5.3.14",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "^8.5.24",
    "tailwindcss": "3.4.4",
    "tsx": "4.16.2",
    "typescript": "5.5.3"
  }
}
