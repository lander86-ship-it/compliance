# --- Database (PostgreSQL) ---
# On Railway, add the Postgres plugin and it injects DATABASE_URL automatically.
# Locally, point this at any Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/securehub?schema=public"

# --- Auth ---
# Secret used to sign session cookies. Generate a long random string in production.
SESSION_SECRET="dev-only-change-me-in-production"
# Comma-separated emails auto-provisioned as owners (admin) on signup — e.g. you.
OWNER_EMAILS=""

# --- Stripe ---
# Set STRIPE_SECRET_KEY to charge real payments via Stripe Checkout. When blank, the
# checkout falls back to a stub grant (no charge) so the app stays usable pre-Stripe.
# The purchase is confirmed on return from Stripe (no webhook required).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Emails whose purchases are always simulated (bypass Stripe) — e.g. the demo client.
DEMO_CUSTOMER_EMAILS="cliente@demo.hardenhub.app"

# --- Object storage (FR-I-03) ---
# MVP stores generated artifacts on the local filesystem under ./storage.
# In production, point this at S3/GCS and issue signed, expiring URLs.
STORAGE_DIR="./storage"

# --- App ---
APP_BASE_URL="http://localhost:3000"

# --- Policy generator (ported from the CIS service) ---
# Optional: enables Claude to draft the policy narrative (Purpose/Scope/Roles/Compliance).
# Controls always stay verbatim. Without a key, a built-in static narrative is used.
ANTHROPIC_API_KEY=""
POLICY_LLM_MODEL="claude-opus-4-8"

# --- CIS source connection (cis-bench, like the /cis service) ---
# The CIS half of the generator connects to CIS WorkBench via the cis-bench CLI,
# using your organisation's CIS SecureSuite session. Provide the WorkBench session
# as a base64-encoded Netscape cookies.txt so the container logs in headless at boot.
# DISA STIGs need none of this (public source). CIS auth is tried in this order:
#   1) an existing cis-bench session, 2) CIS_COOKIES_B64 (base64 cookies.txt),
#   3) CIS_WORKBENCH_USERNAME + CIS_WORKBENCH_PASSWORD (WorkBench form login).
# Accounts with 2FA/SSO must use CIS_COOKIES_B64.
CIS_WORKBENCH_USERNAME=""
CIS_WORKBENCH_PASSWORD=""
CIS_COOKIES_B64=""
CIS_BENCH_BIN="cis-bench"
CIS_WORK_DIR="/work"
