# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Secret used to sign session cookies. Generate a long random string in production.
SESSION_SECRET="dev-only-change-me-in-production"

# --- Stripe (FR-I-01) ---
# Leave blank to run the checkout in STUB mode (no real charge; order auto-marked paid for demos).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Object storage (FR-I-03) ---
# MVP stores generated artifacts on the local filesystem under ./storage.
# In production, point this at S3/GCS and issue signed, expiring URLs.
STORAGE_DIR="./storage"

# --- App ---
APP_BASE_URL="http://localhost:3000"

# --- Policy generator (ported from the CIS service) ---
# Optional: enables Claude to draft the policy narrative (Purpose/Scope/Roles/Compliance).
# Controls always stay verbatim. Without a key, a built-in static narrative is used.
ANTHROPIC_API_KEY=""
POLICY_LLM_MODEL="claude-opus-4-8"

# --- CIS source connection (cis-bench, like the /cis service) ---
# The CIS half of the generator connects to CIS WorkBench via the cis-bench CLI,
# using your organisation's CIS SecureSuite session. Provide the WorkBench session
# as a base64-encoded Netscape cookies.txt so the container logs in headless at boot.
# DISA STIGs need none of this (public source). Without CIS_COOKIES_B64 the CIS
# path reports "connect your CIS WorkBench" and DISA still works.
CIS_COOKIES_B64=""
CIS_BENCH_BIN="cis-bench"
CIS_WORK_DIR="/work"
